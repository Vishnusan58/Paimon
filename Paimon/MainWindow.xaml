<Window x:Class="Paimon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Float AI" Width="380" Height="180"
        WindowStyle="None" AllowsTransparency="True" Background="#DD1E1E1E"
        Topmost="True" ResizeMode="CanResizeWithGrip">
    <Border CornerRadius="14" Background="#FF2B2B2B" Padding="12"
            MouseLeftButtonDown="DragWindow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Pin" Margin="0,0,8,0" Click="ToggleTopMost"/>
                <Button Content="×" Click="CloseApp"/>
            </StackPanel>

            <TextBox x:Name="PromptBox" Grid.Row="1" Margin="0,8,0,8"
                     AcceptsReturn="True" Height="70"
                     TextWrapping="Wrap" Foreground="White" Background="#333"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ask (Screen)" Margin="0,0,8,0" Click="AskWithFullScreen"/>
                <Button Content="Ask (Select Area)" Click="AskWithSelection"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>