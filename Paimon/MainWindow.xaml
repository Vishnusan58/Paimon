<Window x:Class="Paimon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Paimon"
        Title="Paimon AI" Width="540" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- Button Style with Glassmorphism -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Copy Button Style -->
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFF4757"/>
                    <Setter Property="BorderBrush" Value="#FFFF6B7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pin Button Style -->
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer glow effect -->
    <Border Background="Transparent" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#8B5CF6" BlurRadius="50" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <!-- Main glassy container -->
        <Border CornerRadius="24" BorderThickness="1.5" BorderBrush="#60FFFFFF"
                MouseLeftButtonDown="DragWindow">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E01E1B3D" Offset="0"/>
                    <GradientStop Color="#E0262E52" Offset="0.5"/>
                    <GradientStop Color="#E0374B6E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Chat -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- Header with Paimon Avatar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Paimon Avatar -->
                        <Border Width="42" Height="42" CornerRadius="21" 
                                Background="#40FFFFFF" BorderBrush="#60FFFFFF" BorderThickness="1.5"
                                Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Viewbox Width="38" Height="38">
                                    <Canvas Width="38" Height="38">
                                        <!-- Face background -->
                                        <Ellipse Width="38" Height="38" Fill="#FFE8D5" Canvas.Left="0" Canvas.Top="0"/>
                                        <!-- Eyes -->
                                        <Ellipse Width="5.5" Height="7" Fill="#2C3E50" Canvas.Left="11" Canvas.Top="15"/>
                                        <Ellipse Width="5.5" Height="7" Fill="#2C3E50" Canvas.Left="21.5" Canvas.Top="15"/>
                                        <!-- Eye shine -->
                                        <Ellipse Width="2.5" Height="2.5" Fill="White" Canvas.Left="12" Canvas.Top="16"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="White" Canvas.Left="22.5" Canvas.Top="16"/>
                                        <!-- Blush -->
                                        <Ellipse Width="4" Height="2.5" Fill="#FFB6C1" Opacity="0.7" Canvas.Left="7" Canvas.Top="20"/>
                                        <Ellipse Width="4" Height="2.5" Fill="#FFB6C1" Opacity="0.7" Canvas.Left="27" Canvas.Top="20"/>
                                        <!-- Happy mouth -->
                                        <Path Data="M 16,24 Q 19,27 22,24" Stroke="#2C3E50" StrokeThickness="1.5" Fill="Transparent"/>
                                        <!-- Crown/Star decoration -->
                                        <Path Data="M 19,3 L 20.5,7.5 L 25,7.5 L 21.5,10.5 L 23,15 L 19,12 L 15,15 L 16.5,10.5 L 13,7.5 L 17.5,7.5 Z" 
                                              Fill="#FFD700" Stroke="#FFA500" StrokeThickness="0.5"/>
                                        <!-- Add sparkles -->
                                        <Path Data="M 8,8 L 9,10 L 11,11 L 9,12 L 8,14 L 7,12 L 5,11 L 7,10 Z" Fill="#FFD700" Opacity="0.8"/>
                                        <Path Data="M 30,12 L 31,13.5 L 32.5,14.5 L 31,15.5 L 30,17 L 29,15.5 L 27.5,14.5 L 29,13.5 Z" Fill="#FFD700" Opacity="0.8"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Paimon" FontSize="18" FontWeight="Bold" 
                                       Foreground="White"/>
                            <TextBlock Text="Your Emergency Companion ✨" FontSize="10" 
                                       Foreground="#C0FFFFFF" Margin="0,-2,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📋 Copy All" Style="{StaticResource GlassButton}" Margin="0,0,10,0"
                                Click="CopyAllClick" ToolTip="Copy entire conversation"/>
                        <Button Content="📌" Style="{StaticResource PinButton}" 
                                Margin="0,0,8,0" Click="ToggleTopMost" ToolTip="Toggle Always On Top"/>
                        <Button Content="×" Style="{StaticResource CloseButton}" 
                                Click="CloseApp" ToolTip="Close"/>
                    </StackPanel>
                </Grid>

                <!-- Chat Area with improved styling -->
                <Border Grid.Row="1" Background="#15FFFFFF" CornerRadius="16" 
                        BorderBrush="#30FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
                    </Border.Effect>
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChatList">
                            <ItemsControl.Resources>
                                <Style TargetType="TextBlock" x:Key="ChatText">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="LineHeight" Value="22"/>
                                </Style>
                                <DataTemplate DataType="{x:Type local:ChatMessage}">
                                    <Border Margin="0,0,0,12" Padding="14" CornerRadius="14"
                                            Background="{Binding BubbleColor}" 
                                            BorderBrush="#35FFFFFF" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <DockPanel LastChildFill="True">
                                            <!-- Avatar Icon -->
                                            <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0" Width="40">
                                                <Border Width="36" Height="36" CornerRadius="18" 
                                                        Background="#30FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                                    <TextBlock Text="{Binding RoleIcon}" FontSize="20" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Message Content -->
                                            <StackPanel>
                                                <!-- Header with role and timestamp -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding DisplayRole}" FontWeight="Bold" 
                                                               Foreground="#FFFFFF" FontSize="13"/>
                                                    <TextBlock Text="  •  " Foreground="#70FFFFFF" FontSize="12"/>
                                                    <TextBlock Text="{Binding TimeStamp, StringFormat={}{0:HH:mm:ss}}" 
                                                               Foreground="#70FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <!-- Message text -->
                                                <TextBlock Text="{Binding Content}" Style="{StaticResource ChatText}" 
                                                           Margin="0,0,0,8" FontSize="13"/>
                                                
                                                <!-- Copy button (only for Paimon messages) -->
                                                <Button Content="📄 Copy" 
                                                        Style="{StaticResource CopyButton}" 
                                                        HorizontalAlignment="Right"
                                                        Tag="{Binding Content}" 
                                                        Click="CopySingleClick"
                                                        Visibility="{Binding IsPaimonMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Action + Chat Input Row -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/> <!-- Voice toggle -->
                        <ColumnDefinition Width="Auto"/> <!-- Send -->
                        <ColumnDefinition Width="Auto"/> <!-- Full -->
                        <ColumnDefinition Width="Auto"/> <!-- Select -->
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" Grid.Column="0" Height="40" Margin="0,0,10,0"
                             VerticalContentAlignment="Center" Padding="10"
                             Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1"
                             Foreground="White" FontSize="13" TextWrapping="Wrap"
                             AcceptsReturn="True" KeyDown="ChatInput_KeyDown"
                             ToolTip="Type your message. Enter to send, Shift+Enter for newline."/>
                    <Button x:Name="VoiceToggle" Grid.Column="1" Width="48" Height="40" Margin="0,0,10,0"
                            Style="{StaticResource GlassButton}" Click="ToggleVoice" ToolTip="Toggle voice (Paimon talks)">
                        <TextBlock Text="🔊" FontSize="16"/>
                    </Button>
                    <Button x:Name="SendButton" Grid.Column="2" Width="70" Height="40" Margin="0,0,10,0"
                            Style="{StaticResource GlassButton}" Click="SendTravelerMessage" Content="Send"/>
                    <Button Grid.Column="3" Width="112" Height="40" Margin="0,0,10,0" Style="{StaticResource GlassButton}" Click="AskWithFullScreen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥️" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Full" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Width="122" Height="40" Style="{StaticResource GlassButton}" Click="AskWithSelection">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Select" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>